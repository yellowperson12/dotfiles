{
   "layer": "top",
   "modules-left": [
      "sway/workspaces",
      "sway/mode"
   ],
   "modules-center": [
      "sway/window"
   ],
   "modules-right": [
      "tray",
      "memory",
      "cpu",
      "pulseaudio",
      "clock"],
   "sway/window": {
      "max-length": 50
   },
   "clock": {
      "format-alt": "{:%a, %d. %b  %H:%M}"
   },
   "pulseaudio": {
      "format": "{volume}% ",
      "format-bluetooth": "{volume}% {icon}",
      "format-muted": "",
      "format-icons": {
         "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
         "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
         "headphone": "",
         "hands-free": "",
         "headset": "",
         "phone": "",
         "phone-muted": "",
         "portable": "",
         "car": "",
         "default": ["", ""]
      },
      "scroll-step": 1,
      "on-click": "pavucontrol-qt",
      "ignored-sinks": ["Easy Effects Sink"]
   },
   "cpu": {
      "interval": 10,
      "format": "{}% ",
      "max-length": 10
   },
   "memory": {
      "interval": 30,
      "format": "{}%  ",
      "max-length": 10
   }
}
